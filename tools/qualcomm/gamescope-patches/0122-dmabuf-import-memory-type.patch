diff --git a/src/dmabuf_import.hpp b/src/dmabuf_import.hpp
new file mode 100644
index 0000000..ffa002b
--- /dev/null
+++ b/src/dmabuf_import.hpp
@@ -0,0 +1,21 @@
+#pragma once
+#include <vulkan/vulkan_core.h>
+
+namespace gamescope
+{
+inline uint32_t DmabufMemoryType( const VkPhysicalDeviceMemoryProperties &memory,
+    uint32_t imageBits, uint32_t fdBits, VkMemoryPropertyFlags preferred )
+{
+    uint32_t fallback = UINT32_MAX;
+    const uint32_t compatible = imageBits & fdBits;
+    for ( uint32_t i = 0; i < memory.memoryTypeCount; ++i )
+    {
+        if ( !( compatible & ( 1u << i ) ) ) continue;
+        if ( fallback == UINT32_MAX ) fallback = i;
+        if ( ( memory.memoryTypes[i].propertyFlags & preferred ) == preferred ) return i;
+    }
+    // Device-local is a preference for an existing imported buffer. CPU mapping
+    // properties are requirements and must never be silently relaxed.
+    return preferred == VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT ? fallback : UINT32_MAX;
+}
+}
