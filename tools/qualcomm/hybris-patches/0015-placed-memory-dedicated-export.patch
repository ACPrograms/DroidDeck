+static void track_memory(struct device *d, struct memory *m) {
+    pthread_mutex_lock(&lock);
+    m->next = d->memories;
+    d->memories = m;
+    pthread_mutex_unlock(&lock);
+}
+/* Resources stay native. A host-visible allocation that is not dedicated already is
+ * dedicated to a hidden buffer of its size so that it can be exported; the driver binds
+ * other resources to it and the layer never uses the buffer. */
+static VkResult allocate_dedicated_export(struct device *d, VkDevice h,
+                                          const VkMemoryAllocateInfo *ci,
+                                          const VkAllocationCallbacks *ac, VkDeviceMemory *out,
+                                          struct memory *m) {
+    int host = !!(d->host_bits & (1u << ci->memoryTypeIndex));
+    const VkMemoryDedicatedAllocateInfo *ded =
+        (void *)find_chain(ci->pNext, VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO);
+    int own = ded && (ded->buffer || ded->image);
+    VkResult r;
+    if (!host || has_import(ci->pNext) ||
+        find_chain(ci->pNext, VK_STRUCTURE_TYPE_EXPORT_MEMORY_ALLOCATE_INFO)) {
+        r = d->AllocateMemory(h, ci, ac, out);
+        goto done;
+    }
+    VkMemoryAllocateInfo copy = *ci;
+    VkMemoryDedicatedAllocateInfo hidden = {.sType =
+                                                VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO};
+    VkExportMemoryAllocateInfo ext = {.sType = VK_STRUCTURE_TYPE_EXPORT_MEMORY_ALLOCATE_INFO,
+                                      .handleTypes = OPAQUE};
+    struct chain_copy chain = {.a = m->a};
+    if (!own) {
+        VkBufferCreateInfo bi = {.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+                                 .size = ci->allocationSize,
+                                 .usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT |
+                                          VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+                                 .sharingMode = VK_SHARING_MODE_EXCLUSIVE};
+        VkMemoryRequirements req = {0};
+        if (d->CreateBuffer(h, &bi, ac, &m->hidden) == VK_SUCCESS) {
+            d->GetBufferMemoryRequirements(h, m->hidden, &req);
+            if (!(req.memoryTypeBits & (1u << ci->memoryTypeIndex)) ||
+                req.size < ci->allocationSize) {
+                d->DestroyBuffer(h, m->hidden, ac);
+                m->hidden = VK_NULL_HANDLE;
+            }
+        } else
+            m->hidden = VK_NULL_HANDLE;
+        if (!m->hidden) {
+            if (atomic_fetch_add(&failure_logs, 1) < 64)
+                fprintf(stderr, "DD_PLACED dedicated-export: no hidden buffer for size=%llu type=%u\n",
+                        (unsigned long long)ci->allocationSize, ci->memoryTypeIndex);
+            r = d->AllocateMemory(h, ci, ac, out);
+            goto done;
+        }
+        hidden.buffer = m->hidden;
+        copy.allocationSize = req.size;
+        r = chain_edit(ci->pNext, hidden.sType, &hidden, m->a, &chain);
+        if (r != VK_SUCCESS)
+            goto failed;
+        ext.pNext = chain.head;
+    } else
+        ext.pNext = (void *)ci->pNext;
+    copy.pNext = &ext;
+    r = d->AllocateMemory(h, &copy, ac, out);
+    chain_free(&chain);
+    if (r != VK_SUCCESS)
+        goto failed;
+    m->exportable = 1;
+done:
+    if (r != VK_SUCCESS)
+        goto failed;
+    m->h = *out;
+    track_memory(d, m);
+    return VK_SUCCESS;
+failed:
+    if (m->hidden)
+        d->DestroyBuffer(h, m->hidden, ac);
+    dealloc(m->a, m);
+    return r;
+}
