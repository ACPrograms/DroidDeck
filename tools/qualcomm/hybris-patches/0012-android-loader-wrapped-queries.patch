diff --git a/hybris/vulkan/icd/instance.c b/hybris/vulkan/icd/instance.c
index a3e3020..6717d19 100644
--- a/hybris/vulkan/icd/instance.c
+++ b/hybris/vulkan/icd/instance.c
@@ -70,6 +70,27 @@ static void VKAPI_CALL destroy_instance(VkInstance instance,
     free_state(state);
 }
 
+/* Android's loader leaves some core physical-device queries to the driver, so
+ * for its instance they resolve to the HAL's own entries. Which ones it wraps
+ * differs between releases (Android 14 wraps vkGetPhysicalDeviceProperties),
+ * so one identical entry is enough; another driver, or a layer intercepting
+ * all of them, matches none. */
+static int platform_uses_hal(PFN_vkGetInstanceProcAddr platform,
+    PFN_vkGetInstanceProcAddr hal, VkInstance instance)
+{
+    static const char *const queries[] = {
+        "vkGetPhysicalDeviceProperties", "vkGetPhysicalDeviceFeatures",
+        "vkGetPhysicalDeviceMemoryProperties", "vkGetPhysicalDeviceQueueFamilyProperties",
+        "vkGetPhysicalDeviceFormatProperties",
+    };
+    for (size_t i = 0; i < sizeof(queries) / sizeof(queries[0]); ++i) {
+        PFN_vkVoidFunction entry = hal(instance, queries[i]);
+        if (entry && platform(instance, queries[i]) == entry)
+            return 1;
+    }
+    return 0;
+}
+
 VkResult hybris_icd_create_instance(hwvulkan_device_t *hal,
     PFN_vkGetInstanceProcAddr platform,
     const VkInstanceCreateInfo *info, const VkAllocationCallbacks *allocator,
@@ -113,10 +134,8 @@ VkResult hybris_icd_create_instance(hwvulkan_device_t *hal,
     state->resolver = hal->GetInstanceProcAddr;
     state->destroy = (PFN_vkDestroyInstance)platform(*instance, "vkDestroyInstance");
     /* Never pass a handle from an Android layer or an independently selected
-     * updatable driver to our HAL. This core query is an unhooked driver entry
-     * in Android's loader and must resolve to the same implementation. */
-    if (platform(*instance, "vkGetPhysicalDeviceProperties") !=
-        state->resolver(*instance, "vkGetPhysicalDeviceProperties")) {
+     * updatable driver to our HAL. */
+    if (!platform_uses_hal(platform, state->resolver, *instance)) {
         fprintf(stderr, "hybris ICD: Android instance and configured HAL use different dispatch implementations\n");
         state->destroy(*instance, allocator);
         *instance = VK_NULL_HANDLE;
