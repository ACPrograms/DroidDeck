+			const uint64_t ulTarget = g_SteamCompMgrVBlankTime.schedule.ulTargetVBlank;
+			const uint64_t ulCycle = gamescope::mHzToRefreshCycle( g_nNestedRefresh ? g_nNestedRefresh : g_nOutputRefresh );
+			if ( s_ulLastIndexedVBlank && ulCycle && ulTarget + ulCycle / 2 > s_ulLastIndexedVBlank )
+			{
+				const uint64_t ulRefreshes = ( ulTarget + ulCycle / 2 - s_ulLastIndexedVBlank ) / ulCycle;
+				if ( ulRefreshes == 0 )
+					vblank = false; // A second wakeup for a refresh already handled.
+				else
+				{
+					vblank_idx += ulRefreshes;
+					s_ulLastIndexedVBlank = ulTarget;
+				}
+			}
+			else
+			{
+				if ( s_ulLastIndexedVBlank )
+					vblank = false; // A refresh earlier than one already handled.
+				else
+					s_ulLastIndexedVBlank = ulTarget;
+			}
+		}
+		else if ( vblank )
+		{
+			vblank_idx++;
+		}
