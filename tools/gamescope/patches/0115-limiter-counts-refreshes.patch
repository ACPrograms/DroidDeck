 		static uint64_t vblank_idx = 0;
+		// The limiter shows a capped window's frames on every Nth refresh (vblank_idx % N). Count
+		// refreshes, not timer wakeups: nested in a host compositor the timer is re-armed from each
+		// presentation feedback, and it can wake twice for one refresh or sleep through one under
+		// load. Every such wakeup moved the cap's slot by a refresh, so a game capped at 30 on a
+		// 60 Hz host reached it 1 and 3 refreshes apart a quarter of the time.
+		// (With VRR the limiter schedules by time instead, and vblanks need not come from the timer.)
+		static uint64_t s_ulLastIndexedVBlank = 0;
+		if ( vblank && !bVRR )
