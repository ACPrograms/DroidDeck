+    // -r sets the refresh gamescope starts with. With GAMESCOPE_NESTED_REFRESH_FOLLOWS_HOST=1 a refresh
+    // the host compositor reports later replaces it, so pacing and the frame limiter follow a panel
+    // switched to another mode during the session.
+    static void FollowHostRefresh( int32_t nRefreshmHz )
+    {
+        static const bool s_bFollow = []
+        {
+            const char *pszFollow = getenv( "GAMESCOPE_NESTED_REFRESH_FOLLOWS_HOST" );
+            return pszFollow && atoi( pszFollow ) != 0;
+        }();
+        if ( !s_bFollow || !g_nNestedRefresh || g_nNestedRefresh == nRefreshmHz )
+            return;
+        xdg_log.infof( "Nested refresh follows the host: %.3fhz", ConvertmHzToHz( (float) nRefreshmHz ) );
+        g_nNestedRefresh = nRefreshmHz;
+    }
+
     void CWaylandPlane::UpdateVRRRefreshRate()
     {
         if ( m_pParent )
@@ -1724,6 +1740,7 @@ namespace gamescope
